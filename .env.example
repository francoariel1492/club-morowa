NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://morowa:morowa_local@127.0.0.1:3306/morowa
COOKIE_SECURE=false
# SMTP is optional in development; messages stay in the outbox until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Club Morowa <club@example.com>
SHOP_WHATSAPP=
# Only used by the explicit seed command. Change these before real use.
SEED_PASSWORD=MorowaDemo2026!

# Para acceso por Wi-Fi, WEB_ORIGIN debe ser http://IP-DE-LA-MAC:5173
# EXTRA_WEB_ORIGINS=http://otra-ip:5173
# MYSQL_PORT=3307

# HTTPS email API for hosts that block SMTP (for example Render Free)
RESEND_API_KEY=
MAIL_FROM=
# Hosted MySQL: preserve certificate verification
DATABASE_SSL=false
DATABASE_CA_PEM=
# Hosting: serve React from NestJS on a single origin
SERVE_WEB=false
HOST=127.0.0.1
# First startup on an empty CLOUD database only. Never use the public demo password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_ON_EMPTY=false
